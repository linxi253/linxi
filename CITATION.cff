    given-names: "现昆"
    affiliation: "中国科学院大学"
repository-code: "https://github.com/linxi253/linxi"
url: "https://github.com/linxi253/linxi"
keywords:
  - electron microscopy
  - TEM
  - HRTEM
  - STEM
  - 4D-STEM
  - EELS
  - image processing
  - strain analysis
