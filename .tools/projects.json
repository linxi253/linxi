{
  "schema": 2,
  "purpose": "环境与测试契约的单一事实来源：探针、验证、CI 执行行都从这里派生。本文件不记录任何机器专属路径。",
  "rules": {
    "install": "只能安装项目自己的冻结锁（install.chain[0]）；安装过程绝不写锁。",
    "lock_update": "本工具集不实现自动更新锁。锁的更新必须在独立的干净解析环境里完成，再单独审查差异并提交。",
    "tests": "测试用项目自己的解释器与 test.venv；测试依赖走 test_overlay，不升级运行锁中已固定的包。",
    "base": "母本只用于 python -m venv。不向母本装包，也不用母本运行业务代码或测试。",
    "explicit_wins": "显式给出的解释器（环境变量/参数）不合格时立即失败，绝不回退到自动探测结果。"
  },
  "base_interpreters": [
    {
      "id": "py310",
      "version": "3.10"
    },
    {
      "id": "py312",
      "version": "3.12"
    }
  ],
  "interpreter_discovery": {
    "env_var_single": "AIFORTEM_BASE_PY",
    "env_var_map": "AIFORTEM_PYTHONS",
    "env_var_map_format": "3.10=C:\\path\\python.exe;3.12=C:\\other\\python.exe",
    "order": [
      "AIFORTEM_PYTHONS[<version>] / AIFORTEM_PYTHONS[default] / AIFORTEM_BASE_PY（显式，失败即终止）",
      "Windows py launcher: py -<version>",
      "~/miniconda3、~/anaconda3、~/.conda/envs/py<tag>、%LOCALAPPDATA%\\Programs\\Python\\Python<version>",
      "C:\\Python<tag>、C:\\ProgramData\\Miniconda3（含 envs\\py<tag>）",
      "已存在的 conda envs 目录中版本匹配的解释器"
    ]
  },
  "test_overlay": {
    "pytest": "pytest==8.4.2",
    "policy": "已按运行锁安装；overlay 只在 pytest 缺失、或项目 requirements.txt 声明的 pytest 约束与已装版本冲突时安装，且受运行锁约束（不升级锁内包）。锁与 requirements 的 pytest 声明冲突时报告冲突，不静默覆盖。"
  },
  "projects": [
