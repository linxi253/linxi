# 本目录特有规则；通用 Python/构建/显微数据忽略规则见仓库根 .gitignore。

# Local analysis outputs and temporary project writes.
*.tmp
*.metadata.json
PPA_Stats_*/

# Local snapshots taken before refactors; git history supersedes them.
backups/

# Editor/agent local settings (machine-specific).
.claude/settings.local.json

# Deep-learning assets: weights (*.pt/*.onnx) and runs are covered by the root
# .gitignore; datasets are large and reproducible from the training scripts.
datasets/
raw_images/
raw_labels/
yolo_labels/
